{
  "installCommand": "npm install",
  "buildCommand": "npm install --prefix client --include=dev && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.mjs" }]
}
